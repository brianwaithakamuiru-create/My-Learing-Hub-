rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper to check if user is operating on their own record
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles: public read or owner read, owner write only for their own document
    // Prevent modifying role and accountStatus unless existing admin
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && 
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'student') &&
        (!request.resource.data.keys().hasAny(['accountStatus']) || request.resource.data.accountStatus == 'ACTIVE');
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus', 'uid', 'email']));
      allow delete: if false;

      // Personal Timetable subcollection: users/{userId}/timetable/{eventId}
      match /timetable/{eventId} {
        allow read, write: if isOwner(userId);
      }
      match /assignments/{assignmentId} {
        allow read, write: if isOwner(userId);
      }
      match /documents/{documentId} {
        allow read, write: if isOwner(userId);
      }
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }
      match /revision/{revisionId} {
        allow read, write: if isOwner(userId);
      }
      match /calendar/{eventId} {
        allow read, write: if isOwner(userId);
      }
      match /exams/{examId} {
        allow read, write: if isOwner(userId);
      }
      match /knowledge/{entryId} {
        allow read, write: if isOwner(userId);
      }
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /studySessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Unique Username Registry
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Academic Documents
    match /documents/{documentId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Academic Classes & Timetable & Notes
    match /classes/{classId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }
    
    match /notes/{noteId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Academic Goals
    match /goals/{goalId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Focus Sessions Log
    match /focus_sessions/{sessionId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Academic Timetable
    match /timetable/{slotId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Academic Exams
    match /exams/{examId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Academic Notifications & Reminders
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }
  }
}
